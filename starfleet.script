# Starfleet Command v6 - Fedora 44 / Plymouth Script plugin
# Recent system messages are rendered through Plymouth's supported
# SetDisplayMessageFunction / SetHideMessageFunction callbacks.
# The same message panel is used in boot and shutdown splash modes.

background_image = Image ("bridge-background.png");
background_sprite = Sprite (background_image);
background_sprite.SetPosition (0, 0, 0);

#ufp_image = Image ("federation-emblem.png");
#ufp_sprite = Sprite (ufp_image);
#ufp_sprite.SetZ (3);
#ufp_sprite.SetOpacity (1.0);

logo_image = Image ("starfleet-white.png");
logo_sprite = Sprite (logo_image);
logo_sprite.SetZ (4);
logo_sprite.SetOpacity (1.0);

glow_image = Image ("starfleet-halo.png");
glow_sprite = Sprite (glow_image);
glow_sprite.SetZ (2);
glow_sprite.SetOpacity (0.10);

#scan_image = Image ("scan-line.png");
#scan_sprite = Sprite (scan_image);
#scan_sprite.SetZ (6);
#scan_sprite.SetOpacity (0.0);

phase_title_sprite = Sprite ();
phase_detail_sprite = Sprite ();
phase_title_sprite.SetZ (12);
phase_detail_sprite.SetZ (12);
phase_title_sprite.SetOpacity (1.0);
phase_detail_sprite.SetOpacity (0.9);

segment_image = Image ("status-segment.png");
for (i = 0; i < 12; i++)
{
    segment_sprites[i] = Sprite (segment_image);
    segment_sprites[i].SetZ (12);
    segment_sprites[i].SetOpacity (0.12);
}

# Six-line rolling history of messages received from Plymouth.
message_line_count = 6;
for (i = 0; i < message_line_count; i++)
{
    message_texts[i] = "";
    message_images[i] = Image.Text (" ", 0.64, 0.84, 0.90);
    message_sprites[i] = Sprite (message_images[i]);
    message_sprites[i].SetZ (30);
    message_sprites[i].SetOpacity (0.0);
}

angle = 0.0;
blink = 0.0;
scan_tick = 0.0;
boot_progress = 0.0;
boot_complete = 0;
phase = 0;
splash_mode = Plymouth.GetMode ();

fun set_phase_text (title, detail)
{
    phase_title_image = Image.Text (title, 0.78, 0.93, 1.0);
    phase_detail_image = Image.Text (detail, 0.48, 0.72, 0.82);
    phase_title_sprite.SetImage (phase_title_image);
    phase_detail_sprite.SetImage (phase_detail_image);
}

fun update_segments (progress)
{
    for (i = 0; i < 12; i++)
    {
        if (progress >= ((i + 1) / 12.0))
            segment_sprites[i].SetOpacity (0.95);
        else
            segment_sprites[i].SetOpacity (0.12);
    }
}

fun redraw_messages ()
{
    screen_x = Window.GetX ();
    screen_y = Window.GetY ();
    screen_w = Window.GetWidth ();
    screen_h = Window.GetHeight ();

    # Keep a reserved log area below the progress indicator.
    message_y = screen_y + screen_h - 190;
    for (i = 0; i < message_line_count; i++)
    {
        message_images[i] = Image.Text (message_texts[i], 0.64, 0.84, 0.90);
        message_sprites[i].SetImage (message_images[i]);
        message_sprites[i].SetPosition (screen_x + 120, message_y + (i * 25), 30);
        if (message_texts[i] == "")
            message_sprites[i].SetOpacity (0.0);
        else
            message_sprites[i].SetOpacity (0.92);
    }
}

fun add_message (text)
{
    # Ignore empty notifications, but retain all meaningful status lines.
    if (text != "")
    {
        for (i = 0; i < message_line_count - 1; i++)
            message_texts[i] = message_texts[i + 1];

        message_texts[message_line_count - 1] = text;
        redraw_messages ();
    }
}

fun place_artwork ()
{
    screen_x = Window.GetX ();
    screen_y = Window.GetY ();
    screen_w = Window.GetWidth ();
    screen_h = Window.GetHeight ();
    center_x = screen_x + (screen_w / 2);

    ufp_sprite.SetPosition (screen_x + 55, screen_y + 55, 3);

    logo_x = center_x - (logo_image.GetWidth () / 2);
    logo_y = screen_y + 260;
    glow_x = center_x - (glow_image.GetWidth () / 2);
    glow_y = screen_y + 245;
    logo_sprite.SetPosition (logo_x, logo_y, 4);
    glow_sprite.SetPosition (glow_x, glow_y, 2);

    phase_title_width = phase_title_image.GetWidth ();
    phase_detail_width = phase_detail_image.GetWidth ();
    phase_title_sprite.SetPosition (center_x - (phase_title_width / 2), screen_y + 710, 12);
    phase_detail_sprite.SetPosition (center_x - (phase_detail_width / 2), screen_y + 744, 12);

    for (i = 0; i < 12; i++)
        segment_sprites[i].SetPosition (center_x - 246 + (i * 42), screen_y + 780, 12);

    scan_sprite.SetPosition (center_x - (scan_image.GetWidth () / 2), screen_y + 285 + scan_tick, 6);
    redraw_messages ();
}

# Plymouth's Script plugin exposes DisplayMessage and HideMessage callbacks.
# SetMessageFunction is not part of the supported Script API and is not used.
fun display_message_callback (text)
{
    add_message (text);
}
Plymouth.SetDisplayMessageFunction (display_message_callback);

# systemd service status updates are delivered through this separate hook.
# This is the important path for the [  OK  ] / Starting / Started lines
# that become visible when switching Plymouth to detailed mode with ESC.
fun update_status_callback (status)
{
    add_message (status);
}
Plymouth.SetUpdateStatusFunction (update_status_callback);

fun hide_message_callback (text)
{
    # Keep the last six lines as a rolling boot/shutdown log.  Plymouth may
    # send HideMessage as soon as a transient status line has been displayed.
}
Plymouth.SetHideMessageFunction (hide_message_callback);

fun boot_progress_callback (duration, progress)
{
    if (progress < 0.0) progress = 0.0;
    if (progress > 1.0) progress = 1.0;
    boot_progress = progress;

    if (splash_mode == "shutdown")
    {
        if (progress < 0.25)
        {
            if (phase != 1)
                set_phase_text ("INITIATING SHUTDOWN SEQUENCE", "SECURING COMMAND / NAVIGATION SYSTEMS");
            phase = 1;
        }
        else if (progress < 0.70)
        {
            if (phase != 2)
                set_phase_text ("POWERING DOWN SHIP SYSTEMS", "SENSORS / PROPULSION / AUXILIARY SYSTEMS");
            phase = 2;
        }
        else
        {
            if (phase != 3)
                set_phase_text ("FINALIZING SHUTDOWN", "STARFLEET COMMAND LINK CLOSING");
            phase = 3;
        }
    }
    else if (boot_complete == 0)
    {
        if (progress >= 0.999)
        {
            boot_complete = 1;
            phase = 5;
            set_phase_text ("ALL SYSTEMS OPERATIONAL", "STARFLEET COMMAND  /  FEDERATION NETWORK ONLINE");
        }
        else if (progress < 0.18)
        {
            if (phase != 1)
                set_phase_text ("INITIALIZING CORE SYSTEMS", "POWER / LIFE SUPPORT / PROPULSION");
            phase = 1;
        }
        else if (progress < 0.62)
        {
            if (phase != 2)
                set_phase_text ("SCANNING SHIP SYSTEMS", "STRUCTURAL INTEGRITY / NAVIGATION / REACTOR");
            phase = 2;
        }
        else if (progress < 0.94)
        {
            if (phase != 3)
                set_phase_text ("ACTIVATING SENSOR ARRAY", "LONG-RANGE SCAN / TACTICAL SENSORS / TELEMETRY");
            phase = 3;
        }
        else
        {
            if (phase != 4)
                set_phase_text ("FINALIZING STARTUP SEQUENCE", "AWAITING BOOT COMPLETION");
            phase = 4;
        }
    }

    update_segments (progress);
    place_artwork ();
}
Plymouth.SetBootProgressFunction (boot_progress_callback);

fun refresh_callback ()
{
    angle += (2.0 * Math.Pi) / 95.0;
    if (angle > 2.0 * Math.Pi) angle -= 2.0 * Math.Pi;
    pulse = (Math.Cos (angle) + 1.0) / 2.0;

    blink += 1.0;
    if (blink > 180.0) blink = 0.0;
    flash = 0.0;
    if (blink > 0.0 && blink < 9.0) flash = (9.0 - blink) / 9.0;
    glow_sprite.SetOpacity (0.14 + (pulse * 0.19));
    logo_sprite.SetOpacity (0.94 + (pulse * 0.06));

    if (splash_mode == "shutdown")
    {
        scan_tick += 2.0;
        if (scan_tick > 410.0) scan_tick = 0.0;
        scan_sprite.SetOpacity (0.20 + (pulse * 0.24));
    }
    else if (boot_complete == 0)
    {
        scan_tick += 3.0;
        if (scan_tick > 410.0) scan_tick = 0.0;
        scan_sprite.SetOpacity (0.24 + (pulse * 0.28));
    }
    else
    {
        scan_sprite.SetOpacity (0.0);
        logo_sprite.SetOpacity (1.0);
        glow_sprite.SetOpacity (0.16 + (pulse * 0.12));
    }

    place_artwork ();
}
Plymouth.SetRefreshFunction (refresh_callback);

fun quit_callback ()
{
    logo_sprite.SetOpacity (1.0);
    scan_sprite.SetOpacity (0.0);
    if (splash_mode != "shutdown" && boot_progress >= 0.999)
    {
        set_phase_text ("ALL SYSTEMS OPERATIONAL", "STARFLEET COMMAND  /  FEDERATION NETWORK ONLINE");
        update_segments (1.0);
        place_artwork ();
    }
}
Plymouth.SetQuitFunction (quit_callback);

if (splash_mode == "shutdown")
    set_phase_text ("INITIATING SHUTDOWN SEQUENCE", "SECURING COMMAND / NAVIGATION SYSTEMS");
else
    set_phase_text ("INITIALIZING CORE SYSTEMS", "POWER / LIFE SUPPORT / PROPULSION");

place_artwork ();
